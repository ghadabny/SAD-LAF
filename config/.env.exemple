# .env.exemple — Copier en config/.env.dev et adapter à votre environnement

# ── Sources GTFS ──────────────────────────────────────────────────────────────
GTFS_URL=https://eu.ftp.opendatasoft.com/sncf/plandata/export-opendata-sncf-gtfs.zip
GTFS_RT_TRIP_UPDATES_URL=https://proxy.transport.data.gouv.fr/resource/sncf-gtfs-rt-trip-updates
GTFS_RT_SERVICE_ALERTS_URL=https://proxy.transport.data.gouv.fr/resource/sncf-gtfs-rt-service-alerts

# ── API ───────────────────────────────────────────────────────────────────────
PREDICT_API_URL=http://api:8000/predict/batch
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Proxy réseau (laisser vide hors poste SNCF) ───────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=

# ── Chemins des données ───────────────────────────────────────────────────────
DATA_DIR=data
GTFS_DIR=data/raw/gtfs
LAF_DIR=data/raw/laf
MODELS_DIR=data/models
OUTPUTS_DIR=data/outputs

# ── Listener event-driven ─────────────────────────────────────────────────────
# Dossiers synchronisés avec OneDrive pour la communication avec Power Automate.
# Power Automate dépose des fichiers JSON dans REQUESTS_DIR et DECISIONS_DIR.
# Le listener traite ces fichiers et écrit les résultats dans OUTPUTS_DIR.
#
# Sur la ThinkStation : pointer vers le dossier OneDrive synchronisé localement.
# Exemple Windows : REQUESTS_DIR=C:\Users\agent\OneDrive\SAD_LAF\requests
# Exemple Linux/Docker : REQUESTS_DIR=data/requests (par défaut)
REQUESTS_DIR=data/requests
DECISIONS_DIR=data/decisions

# Intervalles de polling du listener (en secondes)
# Augmenter si la ThinkStation est sous charge (ex: 60 et 30)
REQUEST_LISTENER_INTERVAL_SECONDS=30
DECISION_LISTENER_INTERVAL_SECONDS=15
