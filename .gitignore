# === Environnement Python ===
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
build/
dist/
*.spec

# === Packaging Python (généré automatiquement par pip install -e .) ===
*.egg-info/
*.egg
.eggs/

# === Outils de développement ===
.idea/
*.iws
out/
repomix-output.xml

# === Configuration et Secrets ===
config/.env.dev
secrets.json
config.yaml
auth_tokens/
*.pem
*.key

# === Données SNCF (sensibles + volumineuses) ===
# data/raw/      → GTFS Static téléchargé au runtime par le scheduler
# data/processed/ → cache Parquet GTFS-RT, généré au runtime
# data/models/   → artefacts LightGBM, régénérés par ml_engine
# data/outputs/  → CSV/JSON tournées, générés au runtime par l'API
data/raw/
data/processed/
data/models/
data/outputs/
*.csv
*.xlsx
*.json
!patterns_config.json

# === Modèles ML ===
models/*.pkl
models/*.joblib
models/*.bst
models/*.h5

# === Logs et CI ===
logs/
*.log
.pytest_cache/
htmlcov/
.coverage

# === Doc explicative ===
doc/

# === Cache GTFS-RT (généré automatiquement au runtime) ===
data/cache/
*.parquet

# === Fichiers de test API ===
apitest.py

# === Listener event-driven — dossiers de traitement ─────────────────────────
# Les dossiers sont exclus car ils contiennent des données opérationnelles
# (fichiers JSON Power Automate, parfois sensibles).
# Les .gitkeep versionnent la structure de dossiers vide pour que le
# FileListener trouve ses dossiers au démarrage, même sans OneDrive synchronisé.
data/requests/*
data/decisions/*
