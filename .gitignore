# === Listener event-driven — dossiers de traitement ─────────────────────────
# Les dossiers sont exclus car ils contiennent des données opérationnelles
# (fichiers JSON Power Automate, parfois sensibles).
# Les .gitkeep versionnent la structure de dossiers vide pour que le
# FileListener trouve ses dossiers au démarrage, même sans OneDrive synchronisé.
data/requests/*
data/decisions/*
data/raw/*
data/processed/*
data/models/*
data/outputs/*
data/cache/*

# === EXCEPTIONS POUR GARDER LA STRUCTURE (Indispensable pour Docker) ===
# On autorise Git à suivre les fichiers .gitkeep même dans les dossiers ignorés
!**/.gitkeep

# On s'assure que Git ne rejette pas les dossiers eux-mêmes
!data/raw/**/
!data/processed/**/
!data/models/**/
!data/outputs/**/
!data/cache/**/
!data/requests/**/
!data/decisions/**/
