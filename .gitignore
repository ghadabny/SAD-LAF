# === Environnement Python ===
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env
.venv
build/
dist/
*.spec

# === Configuration PyCharm ===
.idea/
*.iws
out/

# === Sécurité et Secrets (CRITIQUE pour OIV) ===
# Ne jamais versionner les clés AD ou secrets Dataverse
secrets.json
config.yaml
auth_tokens/
*.pem
*.key

# === Données et Stockage (Données SNCF sensibles) ===
# On ignore les données brutes et les exports Dataverse/GTFS
data/raw/
data/processed/
*.csv
*.xlsx
*.json
!patterns_config.json # Optionnel : garder uniquement les fichiers de config non sensibles

# === Modèles Machine Learning (MLOps) ===
# On ignore les fichiers lourds de modèles entraînés (utilisez MLflow ou DVC à la place)
models/*.pkl
models/*.joblib
models/*.bst
models/*.h5

# === Logs et Monitoring ===
logs/
*.log
.pytest_cache/
htmlcov/
